///|
fn jpeg_progressive_sample() -> Bytes {
  Bytes::from_array(jpeg_progressive_gray48x32)
}

///|
fn jpeg_progressive_pixel(img : @types.Image, x : Int32, y : Int32) -> Int32 {
  img.data[(y * img.width + x) * 3].to_int()
}

///|
test "jpeg progressive: 6 scans decode to 48x32 image" {
  let img = @codec.decode_jpeg_pure(jpeg_progressive_sample())
  inspect(img.width, content="48")
  inspect(img.height, content="32")
  inspect(img.channels, content="3")
}

///|
test "jpeg progressive: pixels match pillow within 1 lsb" {
  let img = @codec.decode_jpeg_pure(jpeg_progressive_sample())
  let pts : Array[(Int32, Int32, Int32)] = [
    (0, 0, 30),
    (5, 3, 49),
    (10, 7, 153),
    (12, 20, 123),
    (23, 11, 149),
    (31, 19, 103),
    (40, 25, 190),
    (47, 31, 226),
  ]
  for (x, y, want) in pts {
    let got = jpeg_progressive_pixel(img, x, y)
    assert_true(got - want <= 1 && want - got <= 1)
  }
}

///|
test "jpeg progressive: truncated entropy raises instead of panicking" {
  let full = jpeg_progressive_sample()
  let all = full.to_array()
  let cut_arr : Array[Byte] = []
  for i in 0..<300 {
    cut_arr.push(all[i])
  }
  let cut = Bytes::from_array(cut_arr)
  try {
    let _ = @codec.decode_jpeg_pure(cut)
    fail("expected error")
  } catch {
    @types.LoadError::DecodeFailed(_) => assert_true(true)
    _ => fail("wrong error")
  }
}
