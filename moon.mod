name = "walkzzz/image.mbt"

version = "0.1.22"

license = "MIT"

description = "MoonBit image library: pure MoonBit backend for native/wasm-gc/js/wasm multi-target support."

repository = "https://github.com/walkzzz/image.mbt"

keywords = [
  "moonbit",
  "image",
  "png",
  "jpeg",
  "bmp",
  "gif",
  "qoi",
  "resize",
  "hdr",
  "wasm",
  "js",
  "pure",
  "multi-target",
]

preferred_target = "native"

readme = "README.md"

import {
  "walkzzz/image.core@0.1.22",
  "walkzzz/image.codec@0.1.22",
  "walkzzz/image.process@0.1.22",
  "walkzzz/image.photography@0.1.22",
  "walkzzz/image.vision@0.1.22",
  "walkzzz/image.domain@0.1.22",
  "moonbitlang/x@0.5.9",
}
